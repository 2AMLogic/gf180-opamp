print @m.xdut.xm5.m0[vds]
print @m.xdut.xm5.m0[vth]
print @m.xdut.xm5.m0[vdsat]
print @m.xdut.xm5.m0[gm]
print @m.xdut.xm5.m0[gds]
print @m.xdut.xm6.m0[id]
print @m.xdut.xm6.m0[vgs]
print @m.xdut.xm6.m0[vds]
